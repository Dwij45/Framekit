generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Dashboard / API owner. Video bytes are NOT stored here.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assets            Asset[]
  jobs              Job[]
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]
  usageMonths       UsageMonth[]
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String    @unique
  secretHash String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  jobs       Job[]

  @@index([userId])
}

enum AssetStatus {
  uploading
  ready
  failed
}

enum JobType {
  ingest_transcode
  transform
  compose
}

enum JobStatus {
  queued
  probing
  encoding
  packaging
  ready
  failed
  canceled
}

/// Metadata for one uploaded file. Bytes live in object storage (`originalKey`).
model Asset {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        AssetStatus @default(uploading)
  originalKey   String
  fileName      String
  contentType   String
  byteSize      Int?
  probeJson     Json?
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  jobs          Job[]       @relation("JobOutput")
  sourcedJobs   Job[]       @relation("JobSource")
  renditions    Rendition[]

  @@index([userId])
}

model Rendition {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind        String
  label       String
  storageKey  String
  mime        String
  width       Int?
  height      Int?
  byteSize    Int?
  createdAt   DateTime @default(now())

  @@index([assetId])
}

/// One unit of worker work.
model Job {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId        String
  asset          Asset     @relation("JobOutput", fields: [assetId], references: [id], onDelete: Cascade)
  sourceAssetId  String?
  sourceAsset    Asset?    @relation("JobSource", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  type           JobType
  status         JobStatus @default(queued)
  progressPct    Int       @default(0)
  progressStage  String?
  specJson       Json?
  errorCode        String?
  errorMessage     String?
  idempotencyKey   String?
  idempotencyHash  String?
  apiKeyId         String?
  apiKey           ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  usageRecorded    Boolean   @default(false)
  createdAt        DateTime  @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?
  webhookDeliveries WebhookDelivery[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([assetId])
  @@index([sourceAssetId])
  @@index([apiKeyId])
}

model WebhookEndpoint {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  url        String
  secret     String
  createdAt  DateTime           @default(now())
  disabledAt DateTime?
  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id          String          @id @default(cuid())
  endpointId  String
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  event       String
  payloadJson Json
  statusCode  Int?
  attempts    Int             @default(0)
  lastError   String?
  nextRetryAt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([endpointId])
  @@index([jobId])
}

model UsageMonth {
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  yyyymm      String
  encodedMs   Int    @default(0)
  uploadBytes BigInt @default(0)

  @@id([userId, yyyymm])
}
