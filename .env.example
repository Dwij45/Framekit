# Copy to .env — never commit real secrets.

DATABASE_URL=postgresql://framekit:framekit@127.0.0.1:5433/framekit
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=framekit
S3_ACCESS_KEY=framekit
S3_SECRET_KEY=framekitsecret
S3_FORCE_PATH_STYLE=true

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string
AUTH_SECRET=replace-with-a-long-random-string

# Worker
FFMPEG_PATH=ffmpeg
PROBE_MAX_DURATION_SEC=600
PROBE_MAX_BYTES=524288000
